# LUMINA Studio OS // Supabase Cloud Sync Configuration
# Copy this file to .env.local and replace with your Supabase project credentials.
# Also add these two variables in your Vercel Project Dashboard (Settings > Environment Variables).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key-here
